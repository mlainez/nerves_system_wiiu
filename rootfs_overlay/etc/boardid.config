# Serial number sources, in order:
#  1. The Wii U console serial from the SEEPROM (via /usr/bin/wiiu-serial).
#  2. nerves_serial_number / serial_number from the fwup metadata store.
#  3. /proc/cpuinfo.
-b script -f /usr/bin/wiiu-serial
-b uboot_env -u nerves_serial_number
-b uboot_env -u serial_number
-b cpuinfo
