# erlinit configuration (PID 1). Override via Mix config:
# https://hexdocs.pm/nerves/advanced-configuration.html

# Console on the HDMI framebuffer terminal (the GamePad screen stays blank).
-c tty1
--warn-unused-tty
-s "/usr/bin/nbtty"

-e LANG=en_US.UTF-8;LANGUAGE=en;ERL_INETRC=/etc/erl_inetrc
-e ERL_CRASH_DUMP=/data/erl_crash.dump;ERL_CRASH_DUMP_SECONDS=5

# Application data partition (F2FS). Auto-formatted if corrupt. Matches
# NERVES_FW_APPLICATION_PART0_* in fwup_include/fwup-common.conf.
-m /dev/mmcblk0p3:/data:f2fs:nodev:
-m tmpfs:/sys/fs/cgroup:tmpfs:nodev,noexec,nosuid:mode=755,size=1024k
-m debugfs:/sys/kernel/debug:debugfs:nodev,noexec,nosuid:

-r /srv/erlang

# Hostname nerves-<last 4 of serial>; serial comes from /etc/boardid.config.
-d /usr/bin/boardid
-n nerves-%-.4s

--boot shoehorn
