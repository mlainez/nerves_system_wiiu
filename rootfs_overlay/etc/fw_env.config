# Where fw_printenv / fw_setenv find the firmware (U-Boot-format) environment.
# No U-Boot runs on the Wii U — this block is fwup's metadata key/value store.
#
# Must match UBOOT_ENV_OFFSET (16 blocks) and UBOOT_ENV_COUNT (16 blocks) in
# fwup_include/fwup-common.conf:
#   offset = 16 * 512 = 0x2000
#   size   = 16 * 512 = 0x2000
#
# Device name   Device offset   Env. size   Flash sector size   Number of sectors
/dev/mmcblk0    0x2000          0x2000      0x200               16
