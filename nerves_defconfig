# Nerves system defconfig for the Nintendo Wii U (Espresso/Latte, SMP).

# Architecture
BR2_powerpc=y
BR2_powerpc_750=y

# External (prebuilt) toolchain. Built and published via nerves_toolchain_wiiu_ppc;
# its GCC defaults to -mcpu=espresso and carries the SMP atomic-errata patches.
BR2_TOOLCHAIN_EXTERNAL=y
BR2_TOOLCHAIN_EXTERNAL_CUSTOM=y
BR2_TOOLCHAIN_EXTERNAL_DOWNLOAD=y
BR2_TOOLCHAIN_EXTERNAL_URL="https://github.com/Spin42/nerves_toolchain_wiiu_ppc/releases/download/v13.2.0/nerves_toolchain_wiiu_ppc-linux_${shell uname -m}-13.2.0.tar.xz"
BR2_TOOLCHAIN_EXTERNAL_CUSTOM_PREFIX="powerpc-nerves-linux-gnu"
BR2_TOOLCHAIN_EXTERNAL_GCC_13=y
# Must match the SDK's headers exactly (Buildroot validates this).
BR2_TOOLCHAIN_EXTERNAL_HEADERS_6_6=y
BR2_TOOLCHAIN_EXTERNAL_CUSTOM_GLIBC=y
# BR2_TOOLCHAIN_EXTERNAL_INET_RPC is not set
BR2_TOOLCHAIN_EXTERNAL_CXX=y
BR2_TAR_OPTIONS="--no-same-owner"
BR2_BACKUP_SITE="http://dl.nerves-project.org"

# Kernel: linux-wiiu rewrite-6.6-smp. dtbImage.wiiu = zImage + embedded DTB.
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_GIT=y
BR2_LINUX_KERNEL_CUSTOM_REPO_URL="https://gitlab.com/linux-wiiu/linux-wiiu.git"
BR2_LINUX_KERNEL_CUSTOM_REPO_VERSION="rewrite-6.6-smp"
BR2_LINUX_KERNEL_USE_DEFCONFIG=y
BR2_LINUX_KERNEL_DEFCONFIG="wiiu"
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="${NERVES_DEFCONFIG_DIR}/linux-6.6.fragment"
BR2_LINUX_KERNEL_IMAGE_TARGET_CUSTOM=y
BR2_LINUX_KERNEL_IMAGE_TARGET_NAME="dtbImage.wiiu"
BR2_LINUX_KERNEL_IMAGE_NAME="dtbImage.wiiu"
BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y
# linux-patches/0001: force the wifi SDHCI controller to PIO (its SDMA is broken).
BR2_LINUX_KERNEL_PATCH="${NERVES_DEFCONFIG_DIR}/linux-patches"

# Nerves rootfs skeleton / init / device management
BR2_ROOTFS_SKELETON_CUSTOM=y
BR2_ROOTFS_SKELETON_CUSTOM_PATH="${BR2_EXTERNAL_NERVES_PATH}/board/nerves-common/skeleton"
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_EUDEV=y
BR2_ROOTFS_DEVICE_TABLE="${BR2_EXTERNAL_NERVES_PATH}/board/nerves-common/device_table.txt"
BR2_GLOBAL_PATCH_DIR="${BR2_EXTERNAL_NERVES_PATH}/patches"
BR2_ENABLE_LOCALE_WHITELIST="locale-archive"
BR2_GENERATE_LOCALE="en_US.UTF-8"
BR2_ROOTFS_OVERLAY="${BR2_EXTERNAL_NERVES_PATH}/board/nerves-common/rootfs_overlay ${NERVES_DEFCONFIG_DIR}/rootfs_overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="${NERVES_DEFCONFIG_DIR}/post-build.sh ${BR2_EXTERNAL_NERVES_PATH}/board/nerves-common/post-build.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="${NERVES_DEFCONFIG_DIR}/post-createfs.sh"

# Root filesystem: read-only squashfs (A/B)
BR2_TARGET_ROOTFS_SQUASHFS=y
BR2_TARGET_ROOTFS_SQUASHFS4_LZ4=y

# Busybox
BR2_PACKAGE_BUSYBOX_CONFIG="${BR2_EXTERNAL_NERVES_PATH}/board/nerves-common/busybox.config"
BR2_PACKAGE_BUSYBOX_SHOW_OTHERS=y

# Filesystem tooling (/data is F2FS, formatted on first boot; FAT boot partition)
BR2_PACKAGE_E2FSPROGS=y
BR2_PACKAGE_DOSFSTOOLS=y
BR2_PACKAGE_DOSFSTOOLS_FATLABEL=y
BR2_PACKAGE_DOSFSTOOLS_MKFSFAT=y
BR2_PACKAGE_F2FS_TOOLS=y
BR2_PACKAGE_KMOD=y
BR2_PACKAGE_KMOD_TOOLS=y

# nerves_pack runtime deps: libmnl (nerves_uevent), libnl (vintage_net_wifi),
# ca-certificates (TLS).
BR2_PACKAGE_LIBMNL=y
BR2_PACKAGE_LIBNL=y
BR2_PACKAGE_CA_CERTIFICATES=y

# WiFi (Broadcom BCM43362). Firmware + nvram ship via rootfs_overlay/lib/firmware
# (linux-firmware's curated set omits 43362). WPS is required because
# vintage_net_wifi writes wps_cred_processing=1, which a non-WPS build rejects.
BR2_PACKAGE_WPA_SUPPLICANT=y
BR2_PACKAGE_WPA_SUPPLICANT_NL80211=y
BR2_PACKAGE_WPA_SUPPLICANT_CLI=y
BR2_PACKAGE_WPA_SUPPLICANT_WPA3=y
BR2_PACKAGE_WPA_SUPPLICANT_WPS=y
BR2_PACKAGE_WPA_SUPPLICANT_AP_SUPPORT=y
BR2_PACKAGE_WPA_SUPPLICANT_AUTOSCAN=y

# usbutils for USB ethernet adapters
BR2_PACKAGE_USBUTILS=y

# Host tools for scripts/create-boot-img.sh (builds the FAT boot image)
BR2_PACKAGE_HOST_DOSFSTOOLS=y
BR2_PACKAGE_HOST_MTOOLS=y

# Nerves runtime
BR2_NERVES_SYSTEM_NAME="nerves_system_wiiu"
BR2_NERVES_ADDITIONAL_IMAGE_FILES="${NERVES_DEFCONFIG_DIR}/fwup.conf"
BR2_PACKAGE_NBTTY=y
BR2_PACKAGE_NERVES_CONFIG=y
BR2_PACKAGE_NERVES_CONFIG_ACCEPT_RNG_NOTICE=y
